@page
@model RequestsModel

@{
    ViewData["Title"] = "Service Requests";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Service Requests</h1>
            <p class="text-muted">Manage and track maintenance and service requests.</p>
        </div>

        <a class="btn btn-primary" href="/NewRequests">
            + New Request
        </a>
    </div>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   class="form-control"
                   placeholder="Search requests..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </form>

    <div class="card">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted By</th>
                            <th>Assigned To</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var request in Model.Requests)
                        {
                            <tr>
                                <td>@request.RequestTitle</td>

                                <td>@request.Category</td>

                                <td>@request.Priority</td>

                                <td>
                                    <span class="badge @(request.Status == "Open" ? "status-open" : request.Status == "In Progress" ? "status-progress" : "status-resolved")">
                                        @request.Status
                                    </span>
                                </td>

                                <td>@request.SubmittedBy</td>

                                <td>@request.AssignedTo</td>

                                <td>@request.DateSubmitted.ToString("dd MMM yyyy")</td>

                                <td>
                                    <a asp-page="/RequestDetails"
                                       asp-route-id="@request.Id"
                                       class="btn btn-sm btn-secondary">
                                        View Details
                                    </a>

                                    <a asp-page="/EditRequest"
                                       asp-route-id="@request.Id"
                                       class="btn btn-sm btn-primary">
                                        Manage
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>