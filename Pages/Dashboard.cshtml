@page
@model ServiceDesk.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <!-- Header -->
    <div class="dashboard-header">
        <div>
            <span class="dashboard-label">SERVICE DESK</span>
            <h1>Dashboard</h1>
            <p>Monitor and manage workplace service requests.</p>
        </div>

        <a href="/NewRequests" class="dashboard-action">
            + New Request
        </a>
    </div>

    <!-- Statistics -->
    <div class="dashboard-stats">

        <div class="dashboard-card">
            <span class="dashboard-card-label">OPEN REQUESTS</span>
           <h2>@Model.OpenRequests</h2>
            <p>Requests waiting for attention</p>
        </div>

        <div class="dashboard-card">
            <span class="dashboard-card-label">IN PROGRESS</span>
           <h2>@Model.OpenRequests</h2>
            <p>Requests currently being handled</p>
        </div>

        <div class="dashboard-card">
            <span class="dashboard-card-label">RESOLVED</span>
            <h2>@Model.OpenRequests</h2>
            <p>Completed service requests</p>
        </div>

        <div class="dashboard-card">
            <span class="dashboard-card-label">TOTAL REQUESTS</span>
           <h2>@Model.OpenRequests</h2>
            <p>All submitted requests</p>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="dashboard-section">

        <div class="dashboard-section-heading">
            <span>QUICK ACTIONS</span>
            <h2>Manage ServiceDesk</h2>
        </div>

        <div class="dashboard-actions">

            <a href="/NewRequests" class="dashboard-action-card">
                <strong>Submit Request</strong>
                <span>Create a new workplace service request.</span>
            </a>

            <a href="/Requests" class="dashboard-action-card">
                <strong>View Requests</strong>
                <span>Search, assign and manage existing requests.</span>
            </a>

        </div>

    </div>

</div>