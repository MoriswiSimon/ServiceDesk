@page
@model ServiceDesk.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center">
    <h1 class="display-4">ServiceDesk</h1>
    <p>Maintenance & Service Management System</p>
</div>

<div class="row mt-4">

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>Open Requests</h5>
                <h2>0</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>In Progress</h5>
                <h2>0</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>Resolved</h5>
                <h2>0</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>Total Requests</h5>
                <h2>0</h2>
            </div>
        </div>
    </div>

</div>