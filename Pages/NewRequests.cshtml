@page
@model  ServiceDesk.Pages.NewRequestModel

@{
    ViewData["Title"] = "New Service Request";
}

<div class="container">

    <div class="mb-4">
        <h1>New Service Request</h1>
        <p class="text-muted">Submit a new maintenance or service request.</p>
    </div>

    <div class="card">
        <div class="card-body">

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Request</label>
                    <input type="text" class="form-control" name="RequestTitle" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select class="form-select" name="Category" required>
                        <option value="">Select category</option>
                        <option>IT Support</option>
                        <option>Equipment</option>
                        <option>Maintenance</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Priority</label>
                    <select class="form-select" name="Priority" required>
                        <option value="">Select priority</option>
                        <option>Low</option>
                        <option>Medium</option>
                        <option>High</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Submitted By</label>
                    <input type="text" class="form-control" name="SubmittedBy" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" name="Description" rows="4" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit Request
                </button>

                <a href="/Requests" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>