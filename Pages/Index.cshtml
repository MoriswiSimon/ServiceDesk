
@page
@model IndexModel

@{
    ViewData["Title"] = "ServiceDesk";
}

<div class="home-page">

    <!-- Hero -->
    <section class="hero-section">
        <div class="hero-content">
            <span class="hero-label">SERVICE MANAGEMENT SYSTEM</span>

            <h1>Manage workplace requests<br />with confidence.</h1>

            <p>
                ServiceDesk helps teams submit, track, assign,
                and resolve workplace service requests from one place.
            </p>

            <div class="hero-buttons">
                <a href="/NewRequests" class="primary-button">
                    Submit a Request
                </a>

                <a href="/Requests" class="secondary-button">
                    View Requests
                </a>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="features-section">

        <div class="section-heading">
            <span>WHAT WE DO</span>
            <h2>Everything in one place.</h2>
        </div>

        <div class="feature-grid">

            <div class="feature-card">
                <div class="feature-number">01</div>
                <h3>Submit Requests</h3>
                <p>
                    Report IT, equipment, and maintenance issues
                    quickly and efficiently.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-number">02</div>
                <h3>Track Progress</h3>
                <p>
                    Follow service requests from submission
                    through to resolution.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-number">03</div>
                <h3>Assign & Manage</h3>
                <p>
                    Assign requests to the right support team
                    and keep work organised.
                </p>
            </div>

        </div>

    </section>

    <!-- Call to Action -->
    <section class="cta-section">

        <div>
            <span>READY TO GET STARTED?</span>
            <h2>Have a service issue?</h2>
            <p>
                Submit a request and let the support team take it from there.
            </p>
        </div>

        <a href="/NewRequests" class="primary-button">
            Create Request
        </a>

    </section>

</div>
```
